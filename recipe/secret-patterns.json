{
  "_note": "Known credential shapes a recipe must not carry (team profile spec, section 5). Each regex is tested against every string value and key of a recipe. A prefix-style pattern needs at least 8 token characters after the prefix, so prose that merely names a prefix passes. Fixtures live in test/secret-fixtures.json, split into parts so this repository holds no token-shaped literal.",
  "patterns": [
    { "id": "github-classic-token", "description": "GitHub personal access token (ghp_)", "regex": "ghp_[A-Za-z0-9]{8,}" },
    { "id": "github-oauth-token", "description": "GitHub OAuth access token (gho_)", "regex": "gho_[A-Za-z0-9]{8,}" },
    { "id": "github-user-token", "description": "GitHub user-to-server token (ghu_)", "regex": "ghu_[A-Za-z0-9]{8,}" },
    { "id": "github-server-token", "description": "GitHub server-to-server token (ghs_)", "regex": "ghs_[A-Za-z0-9]{8,}" },
    { "id": "github-refresh-token", "description": "GitHub refresh token (ghr_)", "regex": "ghr_[A-Za-z0-9]{8,}" },
    { "id": "github-fine-grained-token", "description": "GitHub fine-grained personal access token (github_pat_)", "regex": "github_pat_[A-Za-z0-9_]{8,}" },
    { "id": "gitlab-personal-token", "description": "GitLab personal, project, or group access token (glpat-)", "regex": "glpat-[A-Za-z0-9_-]{8,}" },
    { "id": "gitlab-oauth-secret", "description": "GitLab OAuth application secret (gloas-)", "regex": "gloas-[A-Za-z0-9_-]{8,}" },
    { "id": "gitlab-runner-token", "description": "GitLab runner authentication token (glrt-)", "regex": "glrt-[A-Za-z0-9_-]{8,}" },
    { "id": "linear-api-key", "description": "Linear API key (lin_api_)", "regex": "lin_api_[A-Za-z0-9]{8,}" },
    { "id": "anthropic-api-key", "description": "Anthropic API key (sk-ant-)", "regex": "sk-ant-[A-Za-z0-9_-]{8,}" },
    { "id": "slack-token", "description": "Slack token (xoxa-, xoxb-, xoxp-, xoxo-, xoxs-, xoxr-)", "regex": "xox[abposr]-[A-Za-z0-9-]{8,}" },
    { "id": "aws-access-key-id", "description": "AWS access key ID (AKIA)", "regex": "(?<![A-Z0-9])AKIA[0-9A-Z]{16}(?![A-Z0-9])" },
    { "id": "private-key", "description": "PEM private key or certificate block (-----BEGIN)", "regex": "-----BEGIN" },
    { "id": "jwt", "description": "JSON Web Token (eyJ, then two dot-separated base64url parts)", "regex": "eyJ[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]{2,}" }
  ]
}
